# Forge Environment Variables (OCI Deployment)
# Copy this file to /mnt/workspace/forge/.env and fill in the required values.
# NEVER commit the actual .env file to version control.
#
# NOTE: Forge uses Kiro CLI headless mode for task execution.
# A Kiro Pro subscription (or higher) is required for headless API key access.
# Generate your API key at: Kiro portal → Settings → API Keys

# Shared secret for authenticating callers (Hermes, Foundry Core).
# Must match the FORGE_API_KEY configured in Hermes and Foundry Core environments.
FORGE_API_KEY=

# Kiro API key for headless CLI authentication (replaces OPENROUTER_API_KEY).
# Required. Requires Kiro Pro subscription or higher for headless mode.
KIRO_API_KEY=

# Port Forge listens on (bound to 127.0.0.1 only).
FORGE_PORT=3100

# Maximum concurrent task executions (valid range: 1-10).
FORGE_MAX_CONCURRENT=3

# Task execution timeout in milliseconds (default: 600000, range: 60000–3600000).
# After this duration, the kiro-cli process is terminated via SIGTERM/SIGKILL.
FORGE_TASK_TIMEOUT_MS=600000

# Base workspace directory for task execution (default: /workspace).
# Mounted from the host at /mnt/workspace. Each task runs in this root.
FORGE_WORKSPACE_ROOT=/workspace

# Kiro CLI home directory for agent configs and session data.
# The foundry-coder agent config is expected at $KIRO_HOME/agents/foundry-coder.json
KIRO_HOME=/data/forge/kiro-home

# Path to the kiro-cli binary (optional, default: found on PATH).
# Set this only if kiro-cli is not on the system PATH.
# KIRO_CLI_PATH=/usr/local/bin/kiro-cli

# Path to the execution log file (inside the container).
FORGE_LOG_PATH=/data/forge/execution.log
