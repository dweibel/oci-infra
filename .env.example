# oci-infra Environment Configuration
# Copy to .env and fill in your values:  cp .env.example .env
#
# This file stores secrets and connection details used by the oci-infra
# deployment and backup scripts. Wiki.js-specific configuration lives in
# the wikijs-infra repo's .env file.
#
# NEVER commit .env to version control.

# ─── OCI Instance Connection ─────────────────────────────────────────────────
# Public IP of the OCI compute instance
# Find via: oci compute instance list-vnics --query 'data[0]."public-ip"'
OCI_INSTANCE_IP=

# SSH key path for connecting to the instance
OCI_SSH_KEY=~/.ssh/oci_agent_coder

# SSH user
OCI_SSH_USER=opc

# ─── OCI Object Storage (Backup) ─────────────────────────────────────────────
# Object Storage namespace — tenancy-level identifier
# Find via: oci os ns get --query 'data' --raw-output
OCI_NAMESPACE=

# OCI region (must match your tenancy's home region)
OCI_REGION=us-ashburn-1

# Customer Secret Key for S3-compatible API access
# Create via: OCI Console → Identity → Users → <user> → Customer Secret Keys
OCI_S3_ACCESS_KEY=
OCI_S3_SECRET_KEY=

# Backup bucket name (created by terraform module.backup)
OCI_BACKUP_BUCKET=agent-coder-dev-backups

# ─── AWS Credentials (Instance) ───────────────────────────────────────────────
# IAM user access key (used on instance for ECR pulls, S3, Bedrock)
# Must be re-deployed after any boot volume re-image.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# AWS region for ECR and Bedrock
AWS_REGION=us-east-1

# ECR registry URL (format: <account-id>.dkr.ecr.<region>.amazonaws.com)
AWS_ECR_REGISTRY=

# S3 bucket for workspace storage
AWS_S3_BUCKET=
